<?xml version="1.0" encoding="utf-8"?>
<!-- Splash Android — mark Relio et wordmark, disposition verticale, sur fond blanc.
     L'image est centree par Android (gravity=center) : `splash_logo.png` ne
     porte que le dessin, sur fond transparent.
     Duree : celle du chargement reel. Aucun delai artificiel n'est ajoute —
     Android retire cette fenetre des que Flutter dessine sa premiere frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>

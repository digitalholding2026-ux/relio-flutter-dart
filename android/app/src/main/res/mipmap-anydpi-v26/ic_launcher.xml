<?xml version="1.0" encoding="utf-8"?>
<!-- Icon adaptatif Android.
     Le fond est un aplat ORANGE plein ; le premier plan porte la structure
     navy et les pages blanches du mark (l'orange du mark s'y confond avec
     le fond, comme sur l'icone livree). La couche monochrome porte le mark
     en noir pour les icones themees Android 13+.
     Voir assets/branding/launcher/. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>

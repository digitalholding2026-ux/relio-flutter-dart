<?xml version="1.0" encoding="utf-8"?>
<!-- Splash Android, API 21+ — variante identique a `drawable/launch_background.xml`.
     Le fond est impose en blanc (#FFFFFF) plutot que `?android:colorBackground`
     : la marque exige un fond clair fixe, et un fond sombre ferait disparaitre
     le wordmark indigo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
